# Copia este fichero como tools/.env y rellénalo. tools/.env no se sube al repo.
LNBITS_URL=https://tu-instancia.lnbits.com
# Token de API de la cuenta de LNbits (se crea en el perfil). Solo lo usa esta herramienta para crear
# monederos; no va nunca al badge.
LNBITS_TOKEN=
# Opcional: si las direcciones van en otro dominio. Por defecto, el de LNBITS_URL.
LNBITS_DOMINIO=
WIFI_SSID=
WIFI_PASS=
